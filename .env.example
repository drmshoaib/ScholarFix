OPENAI_API_KEY=

# Local development bypasses Firebase authentication by default.
# Set REDPEN_DEV_MODE=false for Firebase-backed sign-in.
REDPEN_DEV_MODE=true

# Optional: override the default OpenAI chat model.
OPENAI_MODEL=gpt-4o

# Required only when REDPEN_DEV_MODE=false.
FIREBASE_CREDENTIALS_PATH=firebase_key.json
